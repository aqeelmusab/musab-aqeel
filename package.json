    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "motion": "13.5.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
