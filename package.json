  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "verify:quick": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "verify": "pnpm run verify:quick && pnpm run test:e2e:install && pnpm run test:e2e",
    "postinstall": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@upstash/redis": "1.39.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
